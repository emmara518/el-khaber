{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": true,
      "timeout": 60000
    },
    "animotion": {
      "type": "local",
      "command": ["npx", "-y", "animotion-mcp@1.0.3"],
      "enabled": true,
      "timeout": 60000
    },
    "iconify": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "github:entaytion/iconify-mcp#43fde7cac49d5b1a18be21995bf66c2c62601c24"
      ],
      "enabled": true,
      "timeout": 60000
    }
  }
}
