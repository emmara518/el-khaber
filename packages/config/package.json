{
  "name": "@khabir/config",
  "version": "0.0.1",
  "private": true,
  "description": "Shared ESLint, Prettier, and TypeScript configuration presets for the Al-Khabir monorepo.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    "./eslint": {
      "types": "./src/eslint/index.d.ts",
      "default": "./src/eslint/index.js"
    },
    "./eslint/node": {
      "types": "./src/eslint/node.d.ts",
      "default": "./src/eslint/node.js"
    },
    "./eslint/react-native": {
      "types": "./src/eslint/react-native.d.ts",
      "default": "./src/eslint/react-native.js"
    },
    "./eslint/next": {
      "types": "./src/eslint/next.d.ts",
      "default": "./src/eslint/next.js"
    },
    "./prettier": "./prettier.config.js",
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/node.json": "./tsconfig/node.json",
    "./tsconfig/react.json": "./tsconfig/react.json",
    "./tsconfig/react-native.json": "./tsconfig/react-native.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@eslint/js": "9.15.0",
    "@typescript-eslint/eslint-plugin": "8.15.0",
    "@typescript-eslint/parser": "8.15.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-react": "7.37.2",
    "eslint-plugin-react-hooks": "5.0.0",
    "globals": "15.12.0",
    "typescript-eslint": "8.15.0"
  },
  "peerDependencies": {
    "eslint": "9.15.0"
  },
  "devDependencies": {
    "eslint": "9.15.0",
    "typescript": "5.6.3"
  }
}
