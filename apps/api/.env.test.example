# Isolated PostgreSQL for API integration tests.
# Copy to apps/api/.env.test (git-ignored). NEVER point this at khabir-dev,
# khabir-prod, or any shared/managed database.
#
# docker-compose.test.yml exposes PostgreSQL on host port 5433.
DATABASE_URL=postgresql://khabir:khabir@localhost:5433/khabir_test
