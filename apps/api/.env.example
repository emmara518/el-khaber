# =============================================================================
# Al-Khabir API — environment variables
# Copy to `.env` and fill in real values for local development.
# Never commit `.env` or any file containing real secrets.
#
# Database: managed Supabase PostgreSQL with PostGIS.
# See docs/adr/0004-supabase-postgres.md and docs/local-dev.md.
# Obtain these connection strings from the Supabase dashboard:
#   Project Settings → Database → Connection string
# =============================================================================

# Application
NODE_ENV=development
PORT=3000
API_GLOBAL_PREFIX=api/v1

# Non-sensitive build identity returned by GET /api/v1/version. Platform
# variables (RENDER_GIT_COMMIT, RAILWAY_GIT_COMMIT_SHA, VERCEL_GIT_COMMIT_SHA)
# are read automatically; set GIT_COMMIT_SHA only for other hosts.
APP_VERSION=
GIT_COMMIT_SHA=

# CORS — comma-separated list of allowed origins. No wildcards in production.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:8081

# -----------------------------------------------------------------------------
# Database — Supabase PostgreSQL + PostGIS
# -----------------------------------------------------------------------------
# The application runtime uses the pooled connection (Transaction or Session
# pooler per Supabase plan). For Prisma migrations use the direct connection
# (the pooler does not support DDL or advisory locks). The credentials must
# belong to a dedicated Prisma database user (see docs/local-dev.md §DB).
#
# Examples (replace placeholders with values from the Supabase dashboard):
#   DATABASE_URL=postgresql://postgres.khabir:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
#   DIRECT_URL=postgresql://postgres.khabir:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# For local development the same project can be used; for staging/production
# create separate Supabase projects and rotate credentials.
DATABASE_URL=
DIRECT_URL=

# -----------------------------------------------------------------------------
# Auth — JWT
# Generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace-me-with-a-strong-secret-at-least-32-bytes
JWT_ACCESS_TTL=900               # 15 minutes (seconds)
JWT_REFRESH_TTL=2592000          # 30 days (seconds)
JWT_ISSUER=khabir-api
JWT_AUDIENCE=khabir

# Admin auth (must differ from the user secret)
ADMIN_JWT_ACCESS_SECRET=replace-me-with-a-different-strong-secret
ADMIN_JWT_ACCESS_TTL=900
ADMIN_JWT_REFRESH_TTL=2592000
ADMIN_JWT_ISSUER=khabir-admin-api
ADMIN_JWT_AUDIENCE=khabir-admin

# -----------------------------------------------------------------------------
# Rate limiting (per IP, sliding window)
# -----------------------------------------------------------------------------
RATE_LIMIT_TTL=60                # window in seconds
RATE_LIMIT_MAX=120               # general requests per IP per window
AUTH_RATE_LIMIT_MAX=10           # login/register/refresh/forgot/reset per IP per window

# Layered failed-login budgets (defence in depth, auto-expiring):
#  - (identifier, IP): immediate pair lock (AUTH_MAX_FAILED_LOGINS)
#  - source IP: stops spraying many accounts from one host
#  - account across all IPs: stops distributed brute force; never a
#    permanent lock.
AUTH_LOGIN_IP_MAX=5
AUTH_LOGIN_IP_TTL=900            # 15 minutes
AUTH_LOGIN_USER_MAX=20
AUTH_LOGIN_USER_TTL=3600         # 60 minutes

# -----------------------------------------------------------------------------
# Identity hardening (Task 10D) — failed-login protection
# Bounded failures -> temporary lock -> automatic expiry (never permanent).
# Scoped per (identifier, ip) pair so third parties cannot lock victims out.
# Thresholds are PROVISIONAL pending CTO ratification.
# -----------------------------------------------------------------------------
AUTH_MAX_FAILED_LOGINS=5         # failed logins before a temporary lock
AUTH_FAILURE_LOCK_SECONDS=900    # lock duration (15 minutes); auto-expires

# -----------------------------------------------------------------------------
# Production topology (docs/11_PRODUCTION.md §7.2)
# - HTTP request throttling (@nestjs/throttler) is PER-INSTANCE in-memory:
#   with N replicas the effective per-IP request budget is N × the values
#   above. Size RATE_LIMIT_MAX/AUTH_RATE_LIMIT_MAX accordingly.
# - Failed-login lockout IS shared through PostgreSQL (rate_limit_buckets),
#   so lock state is consistent across instances.
# Render terminates TLS and appends exactly one X-Forwarded-For entry.
# -----------------------------------------------------------------------------
TRUST_PROXY_HOPS=1              # numeric proxy hops; NEVER set to "true"
REPLICAS=1                      # keep in sync with the deployed instance count
MULTI_INSTANCE=false            # informational; enables the topology log
SHARED_STORE_URL=               # legacy/unused (rate-limit lockout uses PostgreSQL)
                                # empty = single-instance mode (the current decision)

# -----------------------------------------------------------------------------
# Password reset (Task 10D) — one-time token lifetime
# -----------------------------------------------------------------------------
PASSWORD_RESET_TTL_SECONDS=1800  # 30 minutes; raw token is never logged/stored

# -----------------------------------------------------------------------------
# Payment proof storage (PHASE 20) — S3-compatible object store, presigned URLs
# Supabase Storage is explicitly OUT OF SCOPE (docs/adr/0004-supabase-postgres.md).
# Objects are PRIVATE by default; uploads use presigned PUTs, admin review
# uses short-lived presigned GETs. No storage credential may use an
# EXPO_PUBLIC_ prefix (server-only — never ship them in the mobile bundle).
# Until these are injected the API boots and runs, but the proof endpoints
# fail closed with a 500 naming the missing variable (never faked).
# -----------------------------------------------------------------------------
PROOF_STORAGE_PROVIDER=local     # s3 | local (local = dev/test double only)
PROOF_S3_BUCKET=                 # S3 bucket name (required when provider=s3)
PROOF_S3_REGION=us-east-1        # S3 region
PROOF_S3_ENDPOINT=               # optional custom S3-compatible endpoint (MinIO/R2/Spaces); empty = AWS
PROOF_S3_ACCESS_KEY_ID=          # server-only access key (required when provider=s3)
PROOF_S3_SECRET_ACCESS_KEY=      # server-only secret (required when provider=s3)
PROOF_URL_TTL_SECONDS=300        # presigned URL lifetime (short-lived by design)
PROOF_MAX_BYTES=5242880          # max proof size in bytes (5MB); MIME allowlist: image/jpeg|image/png|image/webp
PROOF_LOCAL_DIR=.proof-storage   # local-adapter directory (dev/test only, git-ignored data)

# -----------------------------------------------------------------------------
# Service-request media (Track B2) — reuses the PHASE 20 StoragePort/provider
# (PROOF_STORAGE_PROVIDER + credentials above). Keys are server-generated under
# request-media/{userId}/{requestId}/, private, presigned PUT/GET, JPEG/PNG/WebP
# only, verified by HEAD + magic bytes at confirm. Uploads: owner only; reads:
# request participants. Unconfirmed presigned uploads are not persisted; a
# rejected confirm deletes the object (best-effort orphan cleanup).
# Uploads over the per-request cap fail with 409 CONFLICT.
# -----------------------------------------------------------------------------
REQUEST_MEDIA_MAX_BYTES=5242880      # max photo size in bytes (5MB)
REQUEST_MEDIA_MAX_PER_REQUEST=5      # max confirmed photos per service request

# -----------------------------------------------------------------------------
# Avatar storage (WP-01) — SEPARATE bucket/namespace from payment proofs.
# Avatars are PUBLIC images (stable public URLs for profiles/discovery);
# proofs stay PRIVATE. Never point both lifecycles at the same bucket
# prefix, and never ship these under an EXPO_PUBLIC_ prefix (server-only).
# The avatar bucket (or CDN) MUST grant public read on `avatars/*`;
# writes/deletes happen only with the server credentials below.
# Suggested bucket names: khabir-avatars-dev / khabir-avatars-prod
# (configurable here — their existence/access is provisioned out-of-band).
# Until these are injected the API boots and runs, but the avatar
# endpoints fail closed with a 500 naming the missing variable.
# -----------------------------------------------------------------------------
AVATAR_STORAGE_PROVIDER=local    # s3 | local (local = dev/test double only; refused in production)
AVATAR_S3_BUCKET=                # avatar bucket name, PUBLIC-READ on avatars/* (required when provider=s3)
AVATAR_S3_REGION=us-east-1       # S3 region
AVATAR_S3_ENDPOINT=              # optional custom S3-compatible endpoint (MinIO/R2/Spaces); empty = AWS
AVATAR_S3_ACCESS_KEY_ID=         # server-only access key (required when provider=s3)
AVATAR_S3_SECRET_ACCESS_KEY=     # server-only secret (required when provider=s3)
AVATAR_PUBLIC_BASE_URL=          # public base for avatar reads, e.g. https://cdn.example.com
                                 # (required for provider=s3 in production; dev default serves local files)
AVATAR_MAX_BYTES=2097152         # max avatar upload in bytes (2MB); MIME allowlist: image/jpeg|image/png|image/webp
AVATAR_LOCAL_DIR=.avatar-storage # local-adapter directory (dev/test only, git-ignored data)

# -----------------------------------------------------------------------------
# Password reset delivery (P1-4). When PASSWORD_RESET_DELIVERY_URL is set,
# the API POSTs { purpose, contact, token } to that webhook (your email/SMS
# gateway). When unset, delivery is a no-op (the reset token workflow still
# works; the message is simply not sent). PASSWORD_RESET_DELIVERY_TOKEN is
# an optional bearer token for the webhook.
# -----------------------------------------------------------------------------
PASSWORD_RESET_DELIVERY_URL=
PASSWORD_RESET_DELIVERY_TOKEN=
