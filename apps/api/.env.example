# =============================================================================
# Al-Khabir API — environment variables
# Copy to `.env` and fill in real values for local development.
# Never commit `.env` or any file containing real secrets.
# =============================================================================

# Application
NODE_ENV=development
PORT=3000
API_GLOBAL_PREFIX=api/v1

# CORS — comma-separated list of allowed origins. No wildcards in production.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:8081

# Database — local PostgreSQL + PostGIS
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://khabir:khabir_dev_password@localhost:5432/khabir?schema=public

# Auth — JWT
# Generate strong secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-strong-secret-at-least-32-bytes
JWT_ACCESS_TTL=900               # 15 minutes (seconds)
JWT_REFRESH_TTL=2592000          # 30 days (seconds)
JWT_ISSUER=khabir-api
JWT_AUDIENCE=khabir

# Admin auth
# Same generation rule as JWT_ACCESS_SECRET. MUST differ from the user secret.
ADMIN_JWT_ACCESS_SECRET=replace-me-with-a-different-strong-secret
ADMIN_JWT_ACCESS_TTL=900
ADMIN_JWT_REFRESH_TTL=2592000
ADMIN_JWT_ISSUER=khabir-admin-api
ADMIN_JWT_AUDIENCE=khabir-admin

# Rate limiting (per IP, sliding window)
RATE_LIMIT_TTL=60                # window in seconds
RATE_LIMIT_MAX=20                # requests per window
AUTH_RATE_LIMIT_MAX=10           # tighter cap for auth endpoints

# Logging
LOG_LEVEL=log
