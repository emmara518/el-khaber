# =============================================================================
# Al-Khabir API — environment variables
# Copy to `.env` and fill in real values for local development.
# Never commit `.env` or any file containing real secrets.
#
# Database: managed Supabase PostgreSQL with PostGIS.
# See docs/adr/0004-supabase-postgres.md and docs/local-dev.md.
# Obtain these connection strings from the Supabase dashboard:
#   Project Settings → Database → Connection string
# =============================================================================

# Application
NODE_ENV=development
PORT=3000
API_GLOBAL_PREFIX=api/v1

# CORS — comma-separated list of allowed origins. No wildcards in production.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:8081

# -----------------------------------------------------------------------------
# Database — Supabase PostgreSQL + PostGIS
# -----------------------------------------------------------------------------
# The application runtime uses the pooled connection (Transaction or Session
# pooler per Supabase plan). For Prisma migrations use the direct connection
# (the pooler does not support DDL or advisory locks). The credentials must
# belong to a dedicated Prisma database user (see docs/local-dev.md §DB).
#
# Examples (replace placeholders with values from the Supabase dashboard):
#   DATABASE_URL=postgresql://postgres.khabir:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
#   DIRECT_URL=postgresql://postgres.khabir:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# For local development the same project can be used; for staging/production
# create separate Supabase projects and rotate credentials.
DATABASE_URL=
DIRECT_URL=

# -----------------------------------------------------------------------------
# Auth — JWT
# Generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace-me-with-a-strong-secret-at-least-32-bytes
JWT_ACCESS_TTL=900               # 15 minutes (seconds)
JWT_REFRESH_TTL=2592000          # 30 days (seconds)
JWT_ISSUER=khabir-api
JWT_AUDIENCE=khabir

# Admin auth (must differ from the user secret)
ADMIN_JWT_ACCESS_SECRET=replace-me-with-a-different-strong-secret
ADMIN_JWT_ACCESS_TTL=900
ADMIN_JWT_REFRESH_TTL=2592000
ADMIN_JWT_ISSUER=khabir-admin-api
ADMIN_JWT_AUDIENCE=khabir-admin

# -----------------------------------------------------------------------------
# Rate limiting (per IP, sliding window)
# -----------------------------------------------------------------------------
RATE_LIMIT_TTL=60                # window in seconds
RATE_LIMIT_MAX=20                # requests per window
AUTH_RATE_LIMIT_MAX=10           # tighter cap for auth endpoints

# -----------------------------------------------------------------------------
# Identity hardening (Task 10D) — failed-login protection
# Bounded failures -> temporary lock -> automatic expiry (never permanent).
# Scoped per (identifier, ip) pair so third parties cannot lock victims out.
# Thresholds are PROVISIONAL pending CTO ratification.
# -----------------------------------------------------------------------------
AUTH_MAX_FAILED_LOGINS=5         # failed logins before a temporary lock
AUTH_FAILURE_LOCK_SECONDS=900    # lock duration (15 minutes); auto-expires

# Logging
LOG_LEVEL=log
