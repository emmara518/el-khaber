{
  "name": "@khabir/api",
  "version": "0.0.1",
  "private": true,
  "description": "Al-Khabir NestJS backend. Authoritative source for identity, roles, permissions, subscriptions, and order state.",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node -e \"require('fs').rmSync('tsconfig.tsbuildinfo',{force:true})\" && tsc -p tsconfig.json && vitest run --coverage",
    "test:watch": "vitest",
    "provision:test-db": "node scripts/provision-test-db.mjs",
    "test:http-e2e": "node scripts/run-http-e2e.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "clean": "rm -rf dist .turbo",
    "gen:openapi": "ts-node --transpile-only scripts/generate-openapi.ts"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1136.0",
    "@aws-sdk/s3-request-presigner": "3.1136.0",
    "@khabir/shared-types": "workspace:*",
    "@khabir/shared-validation": "workspace:*",
    "@nestjs/common": "10.4.6",
    "@nestjs/core": "10.4.6",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/platform-express": "10.4.6",
    "@nestjs/swagger": "7.4.2",
    "@nestjs/throttler": "6.2.1",
    "@prisma/client": "5.22.0",
    "argon2": "0.41.1",
    "cookie-parser": "1.4.7",
    "dotenv": "16.4.5",
    "prisma": "5.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@khabir/config": "workspace:*",
    "@nestjs/cli": "10.4.7",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "10.4.6",
    "@types/cookie-parser": "1.4.7",
    "@types/express": "4.17.21",
    "@types/js-yaml": "4.0.9",
    "@types/node": "20.14.10",
    "@types/supertest": "6.0.2",
    "@vitest/coverage-v8": "2.1.5",
    "eslint": "9.15.0",
    "js-yaml": "4.1.0",
    "supertest": "7.0.0",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
