{
  "expo": {
    "name": "الخبير",
    "slug": "al-khabir",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "khabir",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.khabir.app"
    },
    "android": {
      "package": "ai.khabir.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B1F3A"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router", "./plugins/with-android-release-hardening"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
