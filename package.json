{
  "name": "al-khabir",
  "version": "0.0.1",
  "private": true,
  "description": "الخبير — premium Arabic-first home-appliance service platform.",
  "packageManager": "pnpm@10.4.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "pnpm": {
    "overrides": {
      "@nestjs/platform-express>multer": "2.5.0",
      "body-parser": "1.20.9",
      "express>proxy-addr": "2.0.8",
      "express>path-to-regexp": "0.1.13",
      "@nestjs/platform-express>express": "4.22.3",
      "sharp": "0.35.5",
      "js-yaml": "4.3.2",
      "lodash": "4.18.1",
      "postcss": "8.5.31",
      "source-map-js": "1.2.2",
      "@expo/cli>tar": "7.5.22",
      "cacache>tar": "7.5.22",
      "shell-quote": "1.11.0",
      "undici": "6.29.1",
      "@xmldom/xmldom": "0.8.15",
      "brace-expansion@1": "1.1.20",
      "brace-expansion@2": "2.1.6",
      "compression": "1.8.2",
      "fast-uri": "3.1.7"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@expo/cli",
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "argon2",
      "esbuild",
      "prisma",
      "sharp"
    ]
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}\" --ignore-path .gitignore",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "security:audit": "node scripts/audit-gate.mjs",
    "db:schema:check": "node scripts/schema-consistency.mjs",
    "db:migrate:dev": "pnpm --filter @khabir/api prisma:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @khabir/api prisma:migrate:deploy",
    "db:studio": "pnpm --filter @khabir/api prisma:studio",
    "db:seed": "pnpm --filter @khabir/api db:seed",
    "gen:openapi": "pnpm --filter @khabir/api gen:openapi",
    "gen:types": "pnpm --filter @khabir/api exec ts-node --transpile-only --project ../../scripts/tsconfig.json ../../scripts/gen-types.ts",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "20.14.10",
    "js-yaml": "4.1.0",
    "prettier": "3.3.3",
    "turbo": "2.3.3",
    "typescript": "5.6.3"
  }
}
